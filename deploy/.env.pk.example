# Copy outside Git as .env.pk on the server. Never commit actual credentials.
# Select an existing, approved version from this private repository's Releases.
SUB2API_PK_VERSION=
# Pin a verified private release tag in production, e.g. 0.2.19-pk.9.
# Do not use latest when restoring or rolling back a production deployment.
# SUB2API_PK_VERSION=0.2.19-pk.9
# Fine-grained GitHub token: only yb1320057104/sub2api, Contents: read.
UPDATE_GITHUB_TOKEN=
# Optional proxy for private release checks and asset downloads.
UPDATE_PROXY_URL=
# Set these only after creating a Turnstile widget that allows the real frontend hostname.
TURNSTILE_REQUIRED=false
# Set to the actual public frontend hostname used by this deployment, e.g. team.sayt.cloud.
TURNSTILE_EXPECTED_HOSTNAME=
# Keep the Turnstile secret key in the server-only settings store or an ignored
# secret file, never in Git. The public site key is saved from the admin panel.
# Optional, used ONLY by the Binance recharge client. Keep credentials server-side.
BINANCE_RECHARGE_PROXY_URL=
# Requires an authenticated HTTP(S) preflight gateway when true; see binance-proxy/README.md.
BINANCE_RECHARGE_PROXY_PREFLIGHT=false
