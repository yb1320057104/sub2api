+func TestPrivateReleaseComparisonVersionOnlyKnownDeploymentSuffixes(t *testing.T) {
+	for _, version := range []string{
+		"0.2.19-pk.58-custom.20261108.4",
+		"0.2.19-pk.58-ha.2026118.4",
+		"0.2.19-pk.58-ha.202611080.4",
+		"0.2.19-pk.58-ha.20261108.0",
+		"0.2.19-pk.58-ha.20261108.4-extra",
+		"0.2.19-pk.58-ha.20261108.a",
+		"0.2.19-pk.58-ha.20261108.4 ",
+		" 0.2.19-pk.58-ha.20261108.4",
+		"vv0.2.19-pk.58-ha.20261108.4",
+		"0.2.19-ha.20261108.4",
+		"0.2.19-pk.58",
+	} {
+		t.Run(version, func(t *testing.T) {
+			require.Equal(t, version, privateReleaseComparisonVersion(version))
+		})
+	}
+	// Preserve the legacy treatment of an unknown private suffix.
+	require.Equal(t, -1, compareVersions("0.2.19-pk.58-custom.20261108.4", "0.2.19-pk.58"))
+	require.Equal(t, 0, compareVersions("0.2.19-pk.58-ha.20261108.4", "0.2.19-pk.58-ha.20261208.99"))
+}
