+func TestUpdateServicePrivateDeploymentVersionDoesNotAuthorizeReleaseMutation(t *testing.T) {
+	for _, version := range []string{"0.2.19-pk.58-ha.20261108.4", "0.2.19-pk.58-secondary.20261108.1741256912"} {
+		t.Run(version, func(t *testing.T) {
+			require.False(t, isPrivateReleaseVersion(version))
+			require.False(t, isPrivateReleaseTag("v"+version))
+			svc := NewUpdateService(&updateServiceCacheStub{}, &updateServiceGitHubClientStub{}, version, "cluster-ha")
+			require.ErrorIs(t, svc.PerformUpdate(context.Background()), ErrUpdateNotAllowed)
+			_, err := svc.ListRollbackVersions(context.Background())
+			require.ErrorIs(t, err, ErrUpdateNotAllowed)
+			require.ErrorIs(t, svc.RollbackToVersion(context.Background(), "0.2.19-pk.57"), ErrUpdateNotAllowed)
+			require.ErrorIs(t, svc.Rollback(), ErrUpdateNotAllowed)
+		})
+	}
