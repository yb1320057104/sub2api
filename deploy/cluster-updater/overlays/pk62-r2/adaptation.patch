+// Package sharedstate selects admission behavior for multiple APIs sharing Redis.
+// It owns no role, lease, health state, scheduler or process lifecycle.
+package sharedstate
+
+import (
+	"os"
+	"strconv"
+	"strings"
+)
+
+// Required preserves the historical single-process policy unless explicitly
+// enabled. Deploy every API sharing the same billing/concurrency state with
+// SUB2API_SHARED_STATE_REQUIRED=true.
+func Required() bool {
+	required, err := strconv.ParseBool(strings.TrimSpace(os.Getenv("SUB2API_SHARED_STATE_REQUIRED")))
+	return err == nil && required
+}
