@@ -0,0 +1,109 @@
+package config
+
+import (
+	"fmt"
+	"net"
+	"os"
+	"strings"
+
+	"github.com/spf13/viper"
+)
+
+const maxTurnstileExpectedHostnames = 8
+
+// NormalizedExpectedHostnames validates only the opt-in list. The legacy single
+// hostname and frontend URL fallback retain their existing interpretation.
+func (c TurnstileConfig) NormalizedExpectedHostnames() ([]string, error) {
+	if len(c.ExpectedHostnames) == 0 {
+		return nil, nil
+	}
+	if strings.TrimSpace(c.ExpectedHostname) != "" {
+		return nil, fmt.Errorf("turnstile.expected_hostname and turnstile.expected_hostnames cannot both be configured")
+	}
+	if len(c.ExpectedHostnames) > maxTurnstileExpectedHostnames {
+		return nil, fmt.Errorf("turnstile.expected_hostnames must contain at most %d entries", maxTurnstileExpectedHostnames)
+	}
+	result := make([]string, 0, len(c.ExpectedHostnames))
+	seen := make(map[string]struct{}, len(c.ExpectedHostnames))
+	for i, raw := range c.ExpectedHostnames {
+		host, ok := normalizeTurnstileAllowedHostname(raw)
+		if !ok {
+			// Do not echo unvalidated configuration content to startup logs.
+			return nil, fmt.Errorf("turnstile.expected_hostnames entry %d must be a DNS hostname without wildcard, URL, port or IP address", i+1)
+		}
+		if _, exists := seen[host]; !exists {
+			seen[host] = struct{}{}
+			result = append(result, host)
+		}
+	}
+	return result, nil
+}
+
+func normalizeTurnstileAllowedHostname(raw string) (string, bool) {
+	if len(raw) > 255 {
+		return "", false
+	}
+	for _, character := range raw {
+		if character < ' ' || character > '~' {
+			return "", false
+		}
+	}
+	host := strings.ToLower(strings.TrimSuffix(strings.TrimSpace(raw), "."))
+	if host == "" || len(host) > 253 || net.ParseIP(host) != nil {
+		return "", false
+	}
+	labels := strings.Split(host, ".")
+	if len(labels) < 2 {
+		return "", false
+	}
+	allNumeric := true
+	for _, label := range labels {
+		if len(label) == 0 || len(label) > 63 || label[0] == '-' || label[len(label)-1] == '-' {
+			return "", false
+		}
+		for _, character := range label {
+			if (character < 'a' || character > 'z') && (character < '0' || character > '9') && character != '-' {
+				return "", false
+			}
+			if character < '0' || character > '9' {
+				allNumeric = false
+			}
+		}
+	}
+	return host, !allNumeric
+}
+
+func loadTurnstileExpectedHostnames() ([]string, error) {
+	const key = "turnstile.expected_hostnames"
+	if raw, configured := os.LookupEnv("TURNSTILE_EXPECTED_HOSTNAMES"); configured {
+		// The environment contract is comma-separated DNS names. An empty value
+		// explicitly selects legacy single-hostname/fallback behavior.
+		if raw == "" {
+			return nil, nil
+		}
+		return strings.Split(raw, ","), nil
+	}
+	// Viper otherwise falls back to the default for a YAML null. Treat an
+	// explicitly malformed list as a configuration error, not a disabled policy.
+	if section, ok := viper.Get("turnstile").(map[string]interface{}); ok {
+		if raw, exists := section["expected_hostnames"]; exists && raw == nil {
+			return nil, fmt.Errorf("turnstile.expected_hostnames must be a list of DNS hostname strings")
+		}
+	}
+	switch value := viper.Get(key).(type) {
+	case []string:
+		return append([]string(nil), value...), nil
+	case []interface{}:
+		hosts := make([]string, 0, len(value))
+		for _, item := range value {
+			host, ok := item.(string)
+			if !ok {
+				return nil, fmt.Errorf("turnstile.expected_hostnames must be a list of DNS hostname strings")
+			}
+			hosts = append(hosts, host)
+		}
+		return hosts, nil
+	default:
+		return nil, fmt.Errorf("turnstile.expected_hostnames must be a list of DNS hostname strings")
+	}
+}
