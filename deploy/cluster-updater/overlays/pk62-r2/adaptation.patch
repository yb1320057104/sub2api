diff --git a/backend/cmd/server/cleanup_drain.go b/backend/cmd/server/cleanup_drain.go
new file mode 100644
--- /dev/null
+++ b/backend/cmd/server/cleanup_drain.go
@@ -0,0 +1,99 @@
+package main
+
+import (
+	"errors"
+	"fmt"
+	"log"
+	"sync"
+	"time"
+)
+
+type cleanupStep struct {
+	name string
+	fn   func() error
+}
+
+// Unlisted services are producers and stop before the accounting consumers.
+// Keep this dependency ordering explicit when adding a lifecycle participant.
+func cleanupPhase(name string) int {
+	switch name {
+	case "LiveObservers":
+		return 0
+	case "PromptAuditService", "ContentModeration":
+		return 2
+	case "UsageRecordWorkerPool":
+		return 3
+	case "PostUsageBilling":
+		return 4
+	case "UsageRepository":
+		return 5
+	case "RegionalFunds", "QualitySignals", "CyberPolicyBalanceWorker", "OpenAIQuotaAutoResetService":
+		return 6
+	case "BillingCacheService", "UserPlatformQuotaUsageFlusher", "DeferredService", "BalanceNotify", "AccountOpsService":
+		return 7
+	case "EmailQueueService", "AuditLogService", "OpsSystemLogSink", "OpsIngressRejectAggregator", "AuthCacheInvalidationWorker", "AuthCacheInvalidationSubscriber", "TimingWheel":
+		return 8
+	case "PluginManager", "BPSWarmPool", "ExcelBPSImages", "OpenAIWSPool", "CyberEvidence", "RequestCapture", "PricingService", "OAuthService", "OpenAIOAuthService", "GeminiOAuthService", "AntigravityOAuthService", "GrokOAuthService", "SubscriptionService", "UserMessageQueue", "Concurrency", "APIKeyQueueWaiters":
+		return 9
+	case "UpstreamStatistics":
+		return 10
+	default:
+		return 1
+	}
+}
+
+func runCleanupPhase(steps []cleanupStep) error {
+	var wg sync.WaitGroup
+	var mu sync.Mutex
+	var failures []error
+	for _, step := range steps {
+		wg.Add(1)
+		go func(step cleanupStep) {
+			defer wg.Done()
+			if err := step.fn(); err != nil {
+				mu.Lock()
+				failures = append(failures, fmt.Errorf("%s: %w", step.name, err))
+				mu.Unlock()
+				return
+			}
+			log.Printf("[Drain] %s completed", step.name)
+		}(step)
+	}
+	wg.Wait()
+	return errors.Join(failures...)
+}
+
+func runOrderedCleanup(steps, infra []cleanupStep) error {
+	for phase := 0; phase <= 10; phase++ {
+		var current []cleanupStep
+		for _, step := range steps {
+			if cleanupPhase(step.name) == phase {
+				current = append(current, step)
+			}
+		}
+		if err := runCleanupPhase(current); err != nil {
+			// Never close downstream resources after an incomplete producer.
+			return err
+		}
+	}
+	for _, step := range infra {
+		if err := step.fn(); err != nil {
+			return fmt.Errorf("%s: %w", step.name, err)
+		}
+	}
+	return nil
+}
+
+func drainCleanup(steps, infra []cleanupStep, budget time.Duration) {
+	done := make(chan struct{})
+	go func() {
+		if err := runOrderedCleanup(steps, infra); err != nil {
+			log.Printf("[Drain] cleanup incomplete; process retained for inspection: %v", err)
+			// A failed/ambiguous write is not automatically replayed. Keep the
+			// process and dependencies available for explicit operator recovery.
+			return
+		}
+		close(done)
+	}()
+	waitForDrain("background/usage/billing cleanup", done, budget)
+}
diff --git a/backend/cmd/server/drain.go b/backend/cmd/server/drain.go
new file mode 100644
--- /dev/null
+++ b/backend/cmd/server/drain.go
@@ -0,0 +1,143 @@
+package main
+
+import (
+	"context"
+	"fmt"
+	"log"
+	"net/http"
+	"os"
+	"strconv"
+	"strings"
+	"sync"
+	"time"
+)
+
+// Graceful drain is opt-in. The budget is an alert deadline, never permission
+// to close storage underneath live streams or unfinished accounting work.
+type drainConfig struct {
+	enabled bool
+	budget  time.Duration
+}
+
+func loadDrainConfig() (drainConfig, error) {
+	cfg := drainConfig{budget: 15 * time.Minute}
+	if raw := strings.TrimSpace(os.Getenv("SUB2API_GRACEFUL_DRAIN")); raw != "" {
+		v, err := strconv.ParseBool(raw)
+		if err != nil {
+			return cfg, fmt.Errorf("SUB2API_GRACEFUL_DRAIN must be a boolean")
+		}
+		cfg.enabled = v
+	}
+	if raw := strings.TrimSpace(os.Getenv("SUB2API_DRAIN_TIMEOUT_SECONDS")); raw != "" {
+		v, err := strconv.Atoi(raw)
+		if err != nil || v < 1 || v > 86400 {
+			return cfg, fmt.Errorf("SUB2API_DRAIN_TIMEOUT_SECONDS must be between 1 and 86400")
+		}
+		cfg.budget = time.Duration(v) * time.Second
+	}
+	return cfg, nil
+}
+
+// The admission decision and count share one mutex. In particular, no request
+// may enter between BeginDrain's zero check and Wait. We wrap only the handler:
+// ResponseWriter retains its original Flusher/Hijacker/Pusher capabilities.
+type requestDrain struct {
+	mu       sync.Mutex
+	draining bool
+	active   int
+	done     chan struct{}
+}
+
+func newRequestDrain() *requestDrain { return &requestDrain{done: make(chan struct{})} }
+
+func (d *requestDrain) Handler(next http.Handler) http.Handler {
+	return http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		d.mu.Lock()
+		if d.draining {
+			d.mu.Unlock()
+			if r.URL.Path == "/ready" {
+				// The readiness handler sees IsDraining and returns schema 1
+				// without touching dependencies that may be shutting down.
+				next.ServeHTTP(w, r)
+				return
+			}
+			w.Header().Set("Retry-After", "5")
+			http.Error(w, "server draining", http.StatusServiceUnavailable)
+			return
+		}
+		d.active++
+		d.mu.Unlock()
+		defer func() {
+			d.mu.Lock()
+			defer d.mu.Unlock()
+			d.active--
+			if d.draining && d.active == 0 {
+				close(d.done)
+			}
+		}()
+		next.ServeHTTP(w, r)
+	})
+}
+
+func (d *requestDrain) BeginDrain() {
+	d.mu.Lock()
+	defer d.mu.Unlock()
+	if d.draining {
+		return
+	}
+	d.draining = true
+	if d.active == 0 {
+		close(d.done)
+	}
+}
+
+func (d *requestDrain) IsDraining() bool {
+	d.mu.Lock()
+	defer d.mu.Unlock()
+	return d.draining
+}
+
+func (d *requestDrain) Wait(ctx context.Context) error {
+	select {
+	case <-d.done:
+		return nil
+	case <-ctx.Done():
+		return ctx.Err()
+	}
+}
+
+// Shutdown does not cancel active handlers. net/http does not track hijacked
+// WebSockets, so the outer handler counter must also reach zero before cleanup.
+func drainHTTP(server *http.Server, d *requestDrain, budget time.Duration) {
+	d.BeginDrain()
+	done := make(chan struct{})
+	go func() {
+		defer close(done)
+		if err := server.Shutdown(context.Background()); err != nil {
+			log.Printf("[Drain] HTTP shutdown: %v", err)
+		}
+		_ = d.Wait(context.Background())
+	}()
+	waitForDrain("HTTP/SSE/WebSocket", done, budget)
+}
+
+func waitForDrain(stage string, done <-chan struct{}, budget time.Duration) {
+	timer := time.NewTimer(budget)
+	defer timer.Stop()
+	select {
+	case <-done:
+		return
+	case <-timer.C:
+		log.Printf("[Drain] %s exceeded alert budget; still waiting, storage remains open", stage)
+	}
+	ticker := time.NewTicker(time.Minute)
+	defer ticker.Stop()
+	for {
+		select {
+		case <-done:
+			return
+		case <-ticker.C:
+			log.Printf("[Drain] still waiting for %s; do not force-stop during planned migration", stage)
+		}
+	}
+}
