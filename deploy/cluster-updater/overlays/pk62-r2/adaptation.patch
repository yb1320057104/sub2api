diff --git a/backend/internal/pkg/drainprobe/drain.go b/backend/internal/pkg/drainprobe/drain.go
new file mode 100644
--- /dev/null
+++ b/backend/internal/pkg/drainprobe/drain.go
@@ -0,0 +1,161 @@
+// Package drainprobe exposes read-only process-local counters on a private Unix
+// socket. Routing must stop admitting new requests before these counters are used.
+package drainprobe
+
+import (
+	"crypto/rand"
+	"encoding/hex"
+	"encoding/json"
+	"errors"
+	"net"
+	"net/http"
+	"os"
+	"path/filepath"
+	"sync"
+	"syscall"
+	"time"
+)
+
+type Snapshot struct {
+	BootID         string `json:"boot_id"`
+	ActiveHTTP     int64  `json:"active_http"`
+	PendingUsage   int64  `json:"pending_usage"`
+	StartedHTTP    uint64 `json:"started_http"`
+	CompletedHTTP  uint64 `json:"completed_http"`
+	StartedUsage   uint64 `json:"started_usage"`
+	CompletedUsage uint64 `json:"completed_usage"`
+	Idle           bool   `json:"idle"`
+}
+
+type Tracker struct {
+	mu    sync.Mutex
+	state Snapshot
+}
+
+var process = newTracker()
+
+func newTracker() *Tracker {
+	var identity [16]byte
+	if _, err := rand.Read(identity[:]); err != nil {
+		panic("drain probe identity unavailable")
+	}
+	return &Tracker{state: Snapshot{BootID: hex.EncodeToString(identity[:])}}
+}
+
+// BeginUsage covers queued, running and synchronous fallback tasks. Call the
+// returned function when a task completes or is explicitly abandoned.
+func BeginUsage() func() { return process.begin(false) }
+
+func (t *Tracker) begin(request bool) func() {
+	t.mu.Lock()
+	if request {
+		t.state.ActiveHTTP++
+		t.state.StartedHTTP++
+	} else {
+		t.state.PendingUsage++
+		t.state.StartedUsage++
+	}
+	t.mu.Unlock()
+	var once sync.Once
+	return func() {
+		once.Do(func() {
+			t.mu.Lock()
+			defer t.mu.Unlock()
+			if request {
+				t.state.ActiveHTTP--
+				t.state.CompletedHTTP++
+			} else {
+				t.state.PendingUsage--
+				t.state.CompletedUsage++
+			}
+		})
+	}
+}
+
+func (t *Tracker) snapshot() Snapshot {
+	t.mu.Lock()
+	defer t.mu.Unlock()
+	value := t.state
+	value.Idle = value.ActiveHTTP == 0 && value.PendingUsage == 0
+	return value
+}
+
+// TrackHTTP leaves the ResponseWriter untouched, including streaming/hijacking
+// interfaces. The host additionally verifies accepted sockets during drain.
+func TrackHTTP(next http.Handler) http.Handler { return process.trackHTTP(next) }
+
+func (t *Tracker) trackHTTP(next http.Handler) http.Handler {
+	return http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		if r.Method == http.MethodGet && (r.URL.Path == "/health" || r.URL.Path == "/ready") {
+			next.ServeHTTP(w, r)
+			return
+		}
+		done := t.begin(true)
+		defer done()
+		next.ServeHTTP(w, r)
+	})
+}
+
+func (t *Tracker) serveStatus(w http.ResponseWriter, r *http.Request) {
+	if r.Method != http.MethodGet || r.URL.Path != "/status" {
+		http.NotFound(w, r)
+		return
+	}
+	w.Header().Set("Content-Type", "application/json")
+	w.Header().Set("Cache-Control", "no-store")
+	_ = json.NewEncoder(w).Encode(t.snapshot())
+}
+
+// StartFromEnv is disabled unless explicitly configured. The parent directory
+// must already be private. Only a same-inode stale socket may be replaced.
+func StartFromEnv() (func(), error) {
+	path := os.Getenv("SUB2API_DRAIN_SOCKET")
+	if path == "" {
+		return func() {}, nil
+	}
+	return process.start(path)
+}
+
+func (t *Tracker) start(path string) (func(), error) {
+	if !filepath.IsAbs(path) || filepath.Clean(path) != path {
+		return nil, errors.New("drain socket must be an absolute clean path")
+	}
+	parent, err := os.Lstat(filepath.Dir(path))
+	if err != nil || !parent.IsDir() || parent.Mode()&os.ModeSymlink != 0 || parent.Mode().Perm()&0077 != 0 {
+		return nil, errors.New("drain socket parent must be a private directory")
+	}
+	if previous, err := os.Lstat(path); err == nil {
+		if previous.Mode()&os.ModeSocket == 0 {
+			return nil, errors.New("drain socket path is not a socket")
+		}
+		peer, dialErr := net.DialTimeout("unix", path, time.Second)
+		if dialErr == nil {
+			_ = peer.Close()
+			return nil, errors.New("drain socket is already serving")
+		}
+		if !errors.Is(dialErr, syscall.ECONNREFUSED) {
+			return nil, errors.New("drain socket ownership is uncertain")
+		}
+		current, err := os.Lstat(path)
+		if err != nil || !os.SameFile(previous, current) {
+			return nil, errors.New("drain socket changed during stale check")
+		}
+		if err := os.Remove(path); err != nil {
+			return nil, err
+		}
+	} else if !os.IsNotExist(err) {
+		return nil, errors.New("drain socket path is inaccessible")
+	}
+	listener, err := net.Listen("unix", path)
+	if err != nil {
+		return nil, err
+	}
+	if err := os.Chmod(path, 0600); err != nil {
+		_ = listener.Close()
+		return nil, err
+	}
+	server := &http.Server{Handler: http.HandlerFunc(t.serveStatus), ReadHeaderTimeout: 2 * time.Second,
+		ReadTimeout: 2 * time.Second, WriteTimeout: 2 * time.Second, IdleTimeout: 2 * time.Second}
+	go func() { _ = server.Serve(listener) }()
+	return func() { _ = server.Close() }, nil
+}
