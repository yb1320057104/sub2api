+// Canceled jobs may still persist progress with their own cleanup contexts.
+func (s *UsageCleanupService) Drain(ctx context.Context) error {
+	if s == nil {
+		return nil
+	}
+	s.Stop()
+	s.lifecycleMu.Lock()
+	done := s.runDone
+	s.lifecycleMu.Unlock()
+	if done == nil {
+		return nil
+	}
+	select {
+	case <-done:
+		return nil
+	case <-ctx.Done():
+		return ctx.Err()
+	}
