new file mode 100644
--- /dev/null
+++ b/backend/internal/service/content_moderation_drain.go
@@ -0,0 +1,70 @@
+package service
+
+import (
+	"context"
+	"errors"
+
+	"github.com/Wei-Shaw/sub2api/internal/pkg/drainprobe"
+)
+
+func (s *ContentModerationService) beginAsyncTask() func() {
+	done := drainprobe.BeginUsage()
+	s.asyncPending.Add(1)
+	return func() {
+		s.asyncPending.Add(-1)
+		done()
+	}
+}
+
+// startLifecycleTask serializes background admission with Drain. In particular,
+// a delayed global-retention activation cannot launch after shutdown started.
+func (s *ContentModerationService) startLifecycleTask(task func()) bool {
+	s.asyncLifecycleMu.Lock()
+	defer s.asyncLifecycleMu.Unlock()
+	if s.asyncDraining {
+		return false
+	}
+	s.asyncLifecycle.goTask(task)
+	return true
+}
+
+func (s *ContentModerationService) asyncDrainQueueEmpty() bool {
+	s.asyncLifecycleMu.RLock()
+	defer s.asyncLifecycleMu.RUnlock()
+	return s.asyncDraining && len(s.asyncQueue) == 0
+}
+
+// Drain closes queue admission only after request/Live producers have finished.
+// Accepted work retains its existing per-task timeout and is not canceled.
+// Repeated calls can wait again after a deadline; DB/Redis must remain open
+// until a call succeeds. Persistent configuration failure keeps us draining.
+func (s *ContentModerationService) Drain(ctx context.Context) error {
+	if s == nil {
+		return nil
+	}
+	s.asyncLifecycleMu.Lock()
+	if !s.asyncDraining {
+		s.asyncDraining = true
+		if s.asyncQueue != nil {
+			close(s.asyncQueue)
+		}
+		if s.cleanupStop != nil {
+			close(s.cleanupStop)
+		}
+	}
+	s.asyncLifecycleMu.Unlock()
+	if err := s.asyncLifecycle.wait(ctx); err != nil {
+		return err
+	}
+	if len(s.asyncQueue) != 0 || s.asyncPending.Load() != 0 {
+		return errors.New("content moderation queue has pending work without a running worker")
+	}
+	return nil
+}
+
+func (s *ContentModerationService) PendingAsyncTasks() int64 {
+	if s == nil {
+		return 0
+	}
+	return s.asyncPending.Load()
+}
