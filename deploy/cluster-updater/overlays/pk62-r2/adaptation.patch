+			change(&cfg)
+			bad, err := redisclient.New(cfg)
+			require.Error(t, err)
+			require.Nil(t, bad)
+			require.NotContains(t, err.Error(), "never-log-this-secret")
+		})
+	}
+	// Sentinel must infer each endpoint identity, never inherit the unused
+	// standalone Host when an explicit common certificate name is absent.
+	cfg = base
+	cfg.Host, cfg.SentinelMasterName, cfg.SentinelAddrs, cfg.TLSServerName = "unused.invalid", "primary", []string{local.Addr()}, ""
+	sentinelClient, err := redisclient.New(cfg)
+	require.NoError(t, err)
+	defer sentinelClient.Close()
+	require.Empty(t, sentinelClient.Options().TLSConfig.ServerName)
+}
