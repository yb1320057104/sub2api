+func redisTestServer(t *testing.T, serverTLS *tls.Config) *miniredis.Miniredis {
+	t.Helper()
+	local := miniredis.NewMiniRedis()
+	var err error
+	if serverTLS == nil {
+		err = local.Start()
+	} else {
+		err = local.StartTLS(serverTLS.Clone())
+	}
+	require.NoError(t, err)
+	t.Cleanup(local.Close)
+	return local
+}
+
+func redisTestSentinel(t *testing.T, master *atomic.Value, serverTLS *tls.Config) *miniredis.Miniredis {
+	t.Helper()
+	local := redisTestServer(t, serverTLS)
+	require.NoError(t, local.Server().Register("SENTINEL", func(peer *server.Peer, _ string, args []string) {
+		if len(args) != 2 || args[1] != "primary" {
+			peer.WriteError("ERR unexpected Sentinel request")
+			return
+		}
+		switch strings.ToLower(args[0]) {
+		case "get-master-addr-by-name":
+			host, port, err := net.SplitHostPort(master.Load().(string))
+			if err != nil {
+				peer.WriteError("ERR invalid test master")
+				return
+			}
+			peer.WriteStrings([]string{host, port})
+		case "sentinels", "replicas":
+			peer.WriteLen(0)
+		default:
+			peer.WriteError("ERR unsupported Sentinel request")
+		}
+	}))
+	return local
+}
