+// ValidateConnection validates transport settings without opening files or
+// connections. Fixed errors never echo endpoint credentials or file contents.
+func (r RedisConfig) ValidateConnection() error {
+	hasMaster := strings.TrimSpace(r.SentinelMasterName) != ""
+	hasSeeds := len(r.SentinelAddrs) > 0
+	if hasMaster != hasSeeds {
+		return fmt.Errorf("redis.sentinel_master_name and redis.sentinel_addrs must be configured together")
+	}
+	if r.SentinelMasterName != strings.TrimSpace(r.SentinelMasterName) || strings.ContainsAny(r.SentinelMasterName, " \r\n\t\x00") {
+		return fmt.Errorf("redis.sentinel_master_name is invalid")
+	}
+	if !hasMaster && (r.SentinelUsername != "" || r.SentinelPassword != "") {
+		return fmt.Errorf("redis sentinel credentials require sentinel mode")
+	}
+	for _, address := range r.SentinelAddrs {
+		host, port, err := net.SplitHostPort(address)
+		number, numberErr := strconv.Atoi(port)
+		if err != nil || numberErr != nil || number < 1 || number > 65535 || host == "" ||
+			strings.ContainsAny(host, " /\\@?#\t\r\n\x00") || strings.TrimSpace(address) != address {
+			return fmt.Errorf("redis.sentinel_addrs must contain host:port endpoints without credentials or URLs")
+		}
+	}
