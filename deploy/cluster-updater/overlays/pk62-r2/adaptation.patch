+// UsageLogRepositoryDrainer is an optional lifecycle interface. Drain must run
+// after all usage writers have completed and before the shared SQL DB closes.
+// It must report a deadline without canceling accepted writes or discarding
+// batches. A later call may continue waiting for the same drain operation.
+type UsageLogRepositoryDrainer interface {
+	Drain(context.Context) error
