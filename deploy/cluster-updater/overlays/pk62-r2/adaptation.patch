+func TestRedisSentinelDiscoveryAndMasterReconnect(t *testing.T) {
+	for _, encrypted := range []bool{false, true} {
+		t.Run(fmt.Sprintf("tls_%t", encrypted), func(t *testing.T) {
+			var serverTLS *tls.Config
+			cfg := config.RedisConfig{
+				SentinelMasterName: "primary", SentinelUsername: "sentinel-user", SentinelPassword: "sentinel-pass",
+				Username: "data-user", Password: "data-pass", DB: 2,
+				DialTimeoutSeconds: 1, ReadTimeoutSeconds: 1, WriteTimeoutSeconds: 1, PoolSize: 2,
+			}
+			if encrypted {
+				ca, certificate, key, tlsServer := redisTestPKI(t)
+				serverTLS = tlsServer
+				cfg.EnableTLS, cfg.TLSCAFile, cfg.TLSCertFile, cfg.TLSKeyFile = true, ca, certificate, key
+				cfg.TLSServerName = "redis.internal.example"
+			}
+			first := redisTestServer(t, serverTLS)
+			second := redisTestServer(t, serverTLS)
+			for _, node := range []*miniredis.Miniredis{first, second} {
+				node.RequireUserAuth(cfg.Username, cfg.Password)
+			}
+			require.NoError(t, first.DB(2).Set("node", "first"))
+			require.NoError(t, second.DB(2).Set("node", "second"))
+			var master atomic.Value
+			master.Store(first.Addr())
+			sentinel := redisTestSentinel(t, &master, serverTLS)
+			sentinel.RequireUserAuth(cfg.SentinelUsername, cfg.SentinelPassword)
+			cfg.SentinelAddrs = []string{sentinel.Addr()}
+			client, err := redisclient.New(cfg)
+			require.NoError(t, err)
+			t.Cleanup(func() { _ = client.Close() })
+			ctx, cancel := context.WithTimeout(context.Background(), 8*time.Second)
+			defer cancel()
+			value, err := client.Get(ctx, "node").Result()
+			require.NoError(t, err)
+			require.Equal(t, "first", value)
+			require.Eventually(t, func() bool { return sentinel.PubSubNumSub("+switch-master")["+switch-master"] > 0 }, 2*time.Second, 10*time.Millisecond)
+			master.Store(second.Addr())
+			oldHost, oldPort, err := net.SplitHostPort(first.Addr())
+			require.NoError(t, err)
+			newHost, newPort, err := net.SplitHostPort(second.Addr())
+			require.NoError(t, err)
+			sentinel.Publish("+switch-master", strings.Join([]string{"primary", oldHost, oldPort, newHost, newPort}, " "))
+			first.Close()
+			require.Eventually(t, func() bool {
+				value, getErr := client.Get(ctx, "node").Result()
+				return getErr == nil && value == "second"
+			}, 3*time.Second, 20*time.Millisecond)
+			require.NoError(t, client.Set(ctx, "after-switch", "new-master", 0).Err())
+			stored, err := second.DB(2).Get("after-switch")
+			require.NoError(t, err)
+			require.Equal(t, "new-master", stored)
+		})
+	}
+}
