diff --git a/backend/cmd/server/readiness.go b/backend/cmd/server/readiness.go
new file mode 100644
--- /dev/null
+++ b/backend/cmd/server/readiness.go
@@ -0,0 +1,111 @@
+package main
+
+import (
+	"context"
+	"database/sql"
+	"encoding/json"
+	"net/http"
+	"strings"
+	"time"
+
+	"github.com/redis/go-redis/v9"
+)
+
+const readinessTimeout = 3 * time.Second
+
+type readinessCheck func(context.Context) string
+
+func postgresReadiness(db *sql.DB) readinessCheck {
+	return func(ctx context.Context) string {
+		if db == nil {
+			return "unavailable"
+		}
+		// All checks run on the same actual application connection/session.
+		var one int
+		var recovery bool
+		var readOnly string
+		err := db.QueryRowContext(ctx, "SELECT 1, pg_is_in_recovery(), current_setting('transaction_read_only')").Scan(&one, &recovery, &readOnly)
+		if err != nil || one != 1 {
+			return "unavailable"
+		}
+		if recovery {
+			return "replica"
+		}
+		if readOnly != "off" {
+			return "read_only"
+		}
+		return "primary"
+	}
+}
+
+func redisReadiness(client *redis.Client) readinessCheck {
+	return func(ctx context.Context) string {
+		if client == nil {
+			return "unavailable"
+		}
+		// WithTimeout shares the actual failover client/pool. It does not create
+		// a separate direct client that could check a different Redis endpoint.
+		conn := client.WithTimeout(readinessTimeout).Conn()
+		defer conn.Close()
+		if err := conn.Ping(ctx).Err(); err != nil {
+			return "unavailable"
+		}
+		info, err := conn.Info(ctx, "replication").Result()
+		if err != nil {
+			return "unavailable"
+		}
+		for _, line := range strings.Split(info, "\n") {
+			if strings.TrimSpace(line) == "role:master" {
+				return "master"
+			}
+		}
+		return "not_master"
+	}
+}
+
+// The response is a versioned dependency contract, not the process liveness
+// endpoint. It never exposes connection strings, credentials or driver errors.
+func withReadiness(next http.Handler, draining func() bool, pg, rd readinessCheck, timeout time.Duration) http.Handler {
+	return http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		if r.URL.Path != "/ready" {
+			next.ServeHTTP(w, r)
+			return
+		}
+		w.Header().Set("Content-Type", "application/json")
+		w.Header().Set("Cache-Control", "no-store")
+		if r.Method != http.MethodGet {
+			w.Header().Set("Allow", http.MethodGet)
+			w.WriteHeader(http.StatusMethodNotAllowed)
+			return
+		}
+		deps := map[string]string{"postgres": "unavailable", "redis": "unavailable"}
+		status := "not_ready"
+		if draining == nil || !draining() {
+			ctx, cancel := context.WithTimeout(r.Context(), timeout)
+			defer cancel()
+			type result struct{ name, value string }
+			results := make(chan result, 2)
+			go func() { results <- result{"postgres", pg(ctx)} }()
+			go func() { results <- result{"redis", rd(ctx)} }()
+			for n := 0; n < 2; n++ {
+				select {
+				case v := <-results:
+					deps[v.name] = v.value
+				case <-ctx.Done():
+					n = 2
+				}
+			}
+			if ctx.Err() == nil && deps["postgres"] == "primary" && deps["redis"] == "master" && (draining == nil || !draining()) {
+				status = "ready"
+			}
+		}
+		if status != "ready" {
+			w.WriteHeader(http.StatusServiceUnavailable)
+		}
+		_ = json.NewEncoder(w).Encode(struct {
+			Status       string            `json:"status"`
+			Schema       int               `json:"readiness_schema"`
+			Dependencies map[string]string `json:"dependencies"`
+		}{status, 1, deps})
+	})
+}
