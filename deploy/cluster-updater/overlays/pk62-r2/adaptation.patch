+	"time"
+
+	"github.com/Wei-Shaw/sub2api/internal/config"
+	"github.com/redis/go-redis/v9"
+)
+
+// New returns a direct or Sentinel-managed client with the same concrete type.
+// It does not ping. Invalid TLS material fails before a client can dial, and
+// Sentinel discovery failures never fall back to the standalone host.
+func New(cfg config.RedisConfig) (*redis.Client, error) {
+	if err := cfg.ValidateConnection(); err != nil {
+		return nil, err
+	}
+	tlsConfig, err := buildTLSConfig(cfg)
+	if err != nil {
+		return nil, err
+	}
+	var dialer func(context.Context, string, string) (net.Conn, error)
+	if tlsConfig != nil {
+		// go-redis's default TLS dialer uses tls.DialWithDialer, which discards
+		// the caller context. Preserve its endpoint selection and TLS policy,
+		// but let readiness/shutdown deadlines also cancel the TLS handshake.
+		timeout := time.Duration(cfg.DialTimeoutSeconds) * time.Second
+		if timeout <= 0 {
+			timeout = 5 * time.Second // go-redis's default dial timeout.
+		}
+		tlsDialer := &tls.Dialer{NetDialer: &net.Dialer{Timeout: timeout}, Config: tlsConfig}
+		dialer = tlsDialer.DialContext
+	}
+	if cfg.SentinelMasterName != "" {
+		return redis.NewFailoverClient(&redis.FailoverOptions{
+			MasterName:            cfg.SentinelMasterName,
+			SentinelAddrs:         append([]string(nil), cfg.SentinelAddrs...),
+			SentinelUsername:      cfg.SentinelUsername,
+			SentinelPassword:      cfg.SentinelPassword,
+			Username:              cfg.Username,
+			Password:              cfg.Password,
+			DB:                    cfg.DB,
+			DialTimeout:           time.Duration(cfg.DialTimeoutSeconds) * time.Second,
+			ReadTimeout:           time.Duration(cfg.ReadTimeoutSeconds) * time.Second,
+			WriteTimeout:          time.Duration(cfg.WriteTimeoutSeconds) * time.Second,
+			ContextTimeoutEnabled: true,
+			PoolSize:              cfg.PoolSize,
+			MinIdleConns:          cfg.MinIdleConns,
+			TLSConfig:             tlsConfig,
+			Dialer:                dialer,
+		}), nil
+	}
+	return redis.NewClient(&redis.Options{
+		Addr:                  cfg.Address(),
+		Username:              cfg.Username,
+		Password:              cfg.Password,
+		DB:                    cfg.DB,
+		DialTimeout:           time.Duration(cfg.DialTimeoutSeconds) * time.Second,
+		ReadTimeout:           time.Duration(cfg.ReadTimeoutSeconds) * time.Second,
+		WriteTimeout:          time.Duration(cfg.WriteTimeoutSeconds) * time.Second,
+		ContextTimeoutEnabled: true,
+		PoolSize:              cfg.PoolSize,
+		MinIdleConns:          cfg.MinIdleConns,
+		TLSConfig:             tlsConfig,
+		Dialer:                dialer,
+	}), nil
+}
+
+func buildTLSConfig(cfg config.RedisConfig) (*tls.Config, error) {
+	if !cfg.EnableTLS {
+		return nil, nil
+	}
+	serverName := cfg.TLSServerName
+	if serverName == "" && cfg.SentinelMasterName == "" {
+		serverName = cfg.Host // Preserve direct-mode hostname verification.
+	}
+	// In Sentinel mode an empty name lets tls.DialWithDialer verify each
+	// discovered endpoint's own address. A fixed name applies to all endpoints.
+	options := &tls.Config{MinVersion: tls.VersionTLS12, ServerName: serverName}
+	if cfg.TLSCAFile != "" {
+		pem, err := os.ReadFile(cfg.TLSCAFile)
+		if err != nil {
+			return nil, fmt.Errorf("redis.tls_ca_file could not be read")
+		}
+		roots := x509.NewCertPool()
+		if !roots.AppendCertsFromPEM(pem) {
+			return nil, fmt.Errorf("redis.tls_ca_file contains no valid CA certificates")
+		}
+		options.RootCAs = roots
+	}
+	if cfg.TLSCertFile != "" {
+		certificate, err := tls.LoadX509KeyPair(cfg.TLSCertFile, cfg.TLSKeyFile)
+		if err != nil {
+			return nil, fmt.Errorf("redis TLS client certificate/key could not be loaded or do not match")
+		}
+		options.Certificates = []tls.Certificate{certificate}
+	}
+	return options, nil
+}
