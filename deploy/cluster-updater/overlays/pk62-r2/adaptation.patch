+func TestRedisTLSDialHonorsCallerDeadline(t *testing.T) {
+	listener, err := net.Listen("tcp", "127.0.0.1:0")
+	require.NoError(t, err)
+	stopServer := make(chan struct{})
+	t.Cleanup(func() { close(stopServer); _ = listener.Close() })
+	go func() {
+		connection, acceptErr := listener.Accept()
+		if acceptErr != nil {
+			return
+		}
+		defer connection.Close()
+		<-stopServer // Accept TCP but intentionally never complete a TLS handshake.
+	}()
+	client, err := redisclient.New(config.RedisConfig{Host: "127.0.0.1", EnableTLS: true,
+		TLSServerName: "redis.internal.example", DialTimeoutSeconds: 5, PoolSize: 1})
+	require.NoError(t, err)
+	defer client.Close()
+	ctx, cancel := context.WithTimeout(context.Background(), 50*time.Millisecond)
+	defer cancel()
+	started := time.Now()
+	connection, err := client.Options().Dialer(ctx, "tcp", listener.Addr().String())
+	if connection != nil {
+		_ = connection.Close()
+	}
+	require.ErrorIs(t, err, context.DeadlineExceeded)
+	require.Less(t, time.Since(started), time.Second, "caller deadline must win over the five-second dial timeout")
+}
