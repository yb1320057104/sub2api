+package repository
+
+import (
+	"context"
+	"errors"
+
+	"github.com/Wei-Shaw/sub2api/internal/service"
+)
+
+var errUsageLogRepositoryDraining = errors.New("usage log repository is draining")
+
+var _ service.UsageLogRepositoryDrainer = (*usageLogRepository)(nil)
+
+func (r *usageLogRepository) beginUsageWrite() bool {
+	r.batchLifecycleMu.Lock()
+	defer r.batchLifecycleMu.Unlock()
+	if r.batchDraining {
+		return false
+	}
+	r.batchCalls.Add(1)
+	return true
+}
+
+// Drain first prevents new writers, then waits for admitted calls before closing
+// their channels. Callers that timed out can leave accepted batches behind, so
+// both batch workers are joined separately before reporting completion.
+func (r *usageLogRepository) Drain(ctx context.Context) error {
+	if r == nil {
+		return nil
+	}
+	r.batchDrainOnce.Do(func() {
+		r.batchLifecycleMu.Lock()
+		r.batchDraining = true
+		r.batchDrainDone = make(chan struct{})
+		r.batchLifecycleMu.Unlock()
+		go func() {
+			r.batchCalls.Wait()
+			// Lazy batcher initialization happens inside admitted writes. Once
+			// these calls returned, no sender/initializer can race channel close.
+			if r.createBatchCh != nil {
+				close(r.createBatchCh)
+			}
+			if r.bestEffortBatchCh != nil {
+				close(r.bestEffortBatchCh)
+			}
+			r.batchWorkers.Wait()
+			close(r.batchDrainDone)
+		}()
+	})
+	select {
+	case <-r.batchDrainDone:
+		return nil
+	case <-ctx.Done():
+		return ctx.Err()
+	}
+}
