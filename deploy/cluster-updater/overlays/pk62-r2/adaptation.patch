+
+func expectBatchUnlock(mock sqlmock.Sqlmock) {
+	mock.ExpectExec(`SELECT pg_advisory_unlock\(\$1\)`).WithArgs(migrationsAdvisoryLockID).
+		WillReturnResult(sqlmock.NewResult(0, 1))
+}
+
+func TestAppliedMigrationBatchChecksEveryFileWithOneRead(t *testing.T) {
+	db, mock, err := sqlmock.New()
+	require.NoError(t, err)
+	defer db.Close()
+	prepareMigrationsBootstrapExpectations(mock)
+	files := fstest.MapFS{}
+	rows := sqlmock.NewRows([]string{"filename", "checksum"})
+	for i := 0; i < 324; i++ {
+		name := fmt.Sprintf("%03d_test.sql", i)
+		content := fmt.Sprintf("SELECT %d;", i)
+		files[name] = &fstest.MapFile{Data: []byte(content)}
+		rows.AddRow(name, migrationChecksum(content))
+	}
+	mock.ExpectQuery("SELECT filename, checksum FROM schema_migrations").WillReturnRows(rows).RowsWillBeClosed()
+	expectBatchUnlock(mock)
+	require.NoError(t, applyMigrationsFS(context.Background(), db, files))
+	require.NoError(t, mock.ExpectationsWereMet())
+}
+
+func TestAppliedMigrationBatchMismatchAfterEarlierValidFilesStillFails(t *testing.T) {
+	db, mock, err := sqlmock.New()
+	require.NoError(t, err)
+	defer db.Close()
+	prepareMigrationsBootstrapExpectations(mock)
+	mock.ExpectQuery("SELECT filename, checksum FROM schema_migrations").WillReturnRows(
+		sqlmock.NewRows([]string{"filename", "checksum"}).AddRow("001.sql", migrationChecksum("SELECT 1;")).AddRow("002.sql", "wrong"))
+	expectBatchUnlock(mock)
+	err = applyMigrationsFS(context.Background(), db, fstest.MapFS{
+		"001.sql": &fstest.MapFile{Data: []byte("SELECT 1;")}, "002.sql": &fstest.MapFile{Data: []byte("SELECT 2;")},
+	})
+	require.ErrorContains(t, err, "migration 002.sql checksum mismatch")
+	require.NoError(t, mock.ExpectationsWereMet())
+}
+
+func TestAppliedMigrationBatchPartialAndNewTransactionalMigration(t *testing.T) {
+	db, mock, err := sqlmock.New()
+	require.NoError(t, err)
+	defer db.Close()
+	prepareMigrationsBootstrapExpectations(mock)
+	mock.ExpectQuery("SELECT filename, checksum FROM schema_migrations").WillReturnRows(
+		sqlmock.NewRows([]string{"filename", "checksum"}).AddRow("001.sql", migrationChecksum("SELECT 1;"))).RowsWillBeClosed()
+	for _, name := range []string{"002.sql", "003.sql"} {
+		content := "SELECT '" + name + "';"
+		mock.ExpectBegin()
+		mock.ExpectExec(regexp.QuoteMeta(content)).WillReturnResult(sqlmock.NewResult(0, 0))
+		mock.ExpectExec(`INSERT INTO schema_migrations`).WithArgs(name, migrationChecksum(content)).WillReturnResult(sqlmock.NewResult(0, 1))
+		mock.ExpectCommit()
+	}
+	expectBatchUnlock(mock)
+	require.NoError(t, applyMigrationsFS(context.Background(), db, fstest.MapFS{
+		"001.sql": &fstest.MapFile{Data: []byte("SELECT 1;")},
+		"002.sql": &fstest.MapFile{Data: []byte("SELECT '002.sql';")},
+		"003.sql": &fstest.MapFile{Data: []byte("SELECT '003.sql';")},
+	}))
+	require.NoError(t, mock.ExpectationsWereMet())
+}
+
+func TestAppliedMigrationBatchQueryScanIterationAndDuplicateFailures(t *testing.T) {
+	for _, kind := range []string{"query", "scan", "iteration", "duplicate"} {
+		t.Run(kind, func(t *testing.T) {
+			db, mock, err := sqlmock.New()
+			require.NoError(t, err)
+			defer db.Close()
+			prepareMigrationsBootstrapExpectations(mock)
+			expected := mock.ExpectQuery("SELECT filename, checksum FROM schema_migrations")
+			switch kind {
+			case "query":
+				expected.WillReturnError(errors.New("query unavailable"))
+			case "scan":
+				expected.WillReturnRows(sqlmock.NewRows([]string{"filename", "checksum"}).AddRow("001.sql", nil)).RowsWillBeClosed()
+			case "iteration":
+				expected.WillReturnRows(sqlmock.NewRows([]string{"filename", "checksum"}).AddRow("001.sql", "checksum").RowError(0, errors.New("iteration failed"))).RowsWillBeClosed()
+			case "duplicate":
+				expected.WillReturnRows(sqlmock.NewRows([]string{"filename", "checksum"}).AddRow("001.sql", "a").AddRow("001.sql", "b")).RowsWillBeClosed()
+			}
+			expectBatchUnlock(mock)
+			require.Error(t, applyMigrationsFS(context.Background(), db, fstest.MapFS{"001.sql": &fstest.MapFile{Data: []byte("SELECT 1;")}}))
+			require.NoError(t, mock.ExpectationsWereMet())
+		})
+	}
+}
+
+func TestAppliedMigrationBatchNewMigrationFailureRollsBackAndUnlocks(t *testing.T) {
+	db, mock, err := sqlmock.New()
+	require.NoError(t, err)
+	defer db.Close()
+	prepareMigrationsBootstrapExpectations(mock)
+	mock.ExpectQuery("SELECT filename, checksum FROM schema_migrations").WillReturnRows(sqlmock.NewRows([]string{"filename", "checksum"}))
+	mock.ExpectBegin()
+	mock.ExpectExec("SELECT 1").WillReturnResult(sqlmock.NewResult(0, 0))
+	mock.ExpectExec("INSERT INTO schema_migrations").WillReturnError(errors.New("record failed"))
+	mock.ExpectRollback()
+	expectBatchUnlock(mock)
+	require.ErrorContains(t, applyMigrationsFS(context.Background(), db, fstest.MapFS{
+		"001.sql": &fstest.MapFile{Data: []byte("SELECT 1;")},
+	}), "record migration 001.sql")
+	require.NoError(t, mock.ExpectationsWereMet())
+}
