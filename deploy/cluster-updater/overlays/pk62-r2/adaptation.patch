+func TestRedisTLSVerificationAndInvalidMaterial(t *testing.T) {
+	ca, certificate, key, serverTLS := redisTestPKI(t)
+	local := redisTestServer(t, serverTLS)
+	host, port, err := net.SplitHostPort(local.Addr())
+	require.NoError(t, err)
