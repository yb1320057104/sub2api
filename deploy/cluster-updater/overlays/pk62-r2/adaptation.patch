+	require.NoError(t, err)
+	base := config.RedisConfig{Host: host, Port: portNumber, EnableTLS: true,
+		TLSServerName: "redis.internal.example", TLSCAFile: ca, TLSCertFile: certificate, TLSKeyFile: key,
+		DialTimeoutSeconds: 1, ReadTimeoutSeconds: 1, WriteTimeoutSeconds: 1, PoolSize: 1}
+	client, err := redisclient.New(base)
+	require.NoError(t, err)
+	defer client.Close()
+	ctx, cancel := context.WithTimeout(context.Background(), 5*time.Second)
+	defer cancel()
+	require.NoError(t, client.Ping(ctx).Err(), "loopback dialing must verify the configured DNS certificate name")
+	for _, name := range []string{"", "wrong.internal.example"} {
+		cfg := base
+		cfg.TLSServerName = name
+		bad, err := redisclient.New(cfg)
+		require.NoError(t, err)
+		probeCtx, stop := context.WithTimeout(context.Background(), 2*time.Second)
+		var verification *tls.CertificateVerificationError
+		require.ErrorAs(t, bad.Ping(probeCtx).Err(), &verification, "wrong/default loopback identity must not bypass TLS verification")
+		stop()
+		_ = bad.Close()
+	}
+	otherCA, _, otherKey, _ := redisTestPKI(t)
+	cfg := base
+	cfg.TLSCAFile = otherCA
+	untrusted, err := redisclient.New(cfg)
+	require.NoError(t, err)
+	probeCtx, stop := context.WithTimeout(context.Background(), 2*time.Second)
+	var verification *tls.CertificateVerificationError
+	require.ErrorAs(t, untrusted.Ping(probeCtx).Err(), &verification, "a different CA must not be trusted")
+	stop()
+	_ = untrusted.Close()
+	invalid := filepath.Join(t.TempDir(), "never-log-this-secret.pem")
+	require.NoError(t, os.WriteFile(invalid, []byte("not a certificate never-log-this-secret"), 0600))
+	for name, change := range map[string]func(*config.RedisConfig){
+		"missing CA":              func(c *config.RedisConfig) { c.TLSCAFile = invalid + ".missing" },
+		"invalid CA":              func(c *config.RedisConfig) { c.TLSCAFile = invalid },
+		"missing client key":      func(c *config.RedisConfig) { c.TLSKeyFile = invalid + ".missing" },
+		"mismatched key":          func(c *config.RedisConfig) { c.TLSKeyFile = otherKey },
+		"TLS disabled with files": func(c *config.RedisConfig) { c.EnableTLS = false },
+	} {
+		t.Run(name, func(t *testing.T) {
