+func TestUpdateServicePrivateDeploymentVersionFreshAndCache(t *testing.T) {
+	for _, tt := range []struct {
+		name, current, latest string
+		wantUpdate            bool
+	}{
+		{"same_ha", "0.2.19-pk.58-ha.20261108.4", "0.2.19-pk.58", false},
+		{"lower_release", "0.2.19-pk.58-ha.20261108.4", "0.2.19-pk.57", false},
+		{"newer_release", "0.2.19-pk.58-ha.20261108.4", "0.2.19-pk.59", true},
+		{"newer_upstream", "0.2.19-pk.58-ha.20261108.4", "0.2.20-pk.1", true},
+		{"older_upstream", "0.2.19-pk.58-ha.20261108.4", "0.2.18-pk.99", false},
+		{"leading_v", "v0.2.19-pk.58-ha.20261108.4", "0.2.19-pk.58", false},
+		{"different_date_revision", "0.2.19-pk.58-ha.20270101.1741256912", "0.2.19-pk.58", false},
+		{"ordinary_secondary", "0.2.19-pk.58-secondary.20261108.1741256912", "0.2.19-pk.58", false},
+		{"secondary_newer_release", "0.2.19-pk.58-secondary.20261108.1741256912", "0.2.19-pk.59", true},
+	} {
+		t.Run(tt.name, func(t *testing.T) {
+			cache := &updateServiceCacheStub{}
+			client := &updateServiceGitHubClientStub{release: &GitHubRelease{TagName: "v" + tt.latest}}
+			svc := NewUpdateService(cache, client, tt.current, "cluster-ha")
+			fresh, err := svc.CheckUpdate(context.Background(), true)
+			require.NoError(t, err)
+			require.False(t, fresh.Cached)
+			require.Equal(t, tt.wantUpdate, fresh.HasUpdate)
+			require.Equal(t, tt.current, fresh.CurrentVersion)
+			require.Equal(t, "cluster-ha", fresh.BuildType)
+			client.latestErr = errors.New("GitHub unavailable after fresh response")
+			cached, err := svc.CheckUpdate(context.Background(), false)
+			require.NoError(t, err)
+			require.True(t, cached.Cached)
+			require.Equal(t, tt.wantUpdate, cached.HasUpdate)
+			require.Equal(t, tt.current, cached.CurrentVersion)
+			require.Equal(t, tt.latest, cached.LatestVersion)
+			require.Equal(t, "cluster-ha", cached.BuildType)
+		})
+	}
+}
