+func TestSharedStateInflightHandlerRejectsBeforeForwarding(t *testing.T) {
+	t.Setenv("SUB2API_SHARED_STATE_REQUIRED", "true")
+	for _, scenario := range []string{"missing billing", "disabled", "unpriced", "missing cache"} {
+		t.Run(scenario, func(t *testing.T) {
+			cfg := &config.Config{}
+			cfg.Billing.InflightReservation.Enabled = scenario != "disabled"
+			billing := service.NewBillingCacheService(nil, nil, nil, nil, nil, nil, cfg, nil)
+			t.Cleanup(billing.Stop)
+			if scenario == "missing billing" {
+				billing = nil
+			}
+			estimator := &countingEstimator{cost: 1, priced: scenario != "unpriced"}
+			key := &service.APIKey{User: &service.User{ID: 1}}
+			ctx, done, err := reserveInflightBalanceCtx(context.Background(), billing, estimator, key, nil, service.InflightEstimateRequest{Model: "metered"})
+			require.ErrorIs(t, err, service.ErrBillingServiceUnavailable)
+			require.Nil(t, service.InflightReservationFromContext(ctx))
+			done()
+		})
+	}
+}
+
+func TestSharedStateInflightHandlerKeepsKnownFreeAndNonMeteredRequests(t *testing.T) {
+	t.Setenv("SUB2API_SHARED_STATE_REQUIRED", "true")
+	cfg := &config.Config{}
+	cfg.Billing.InflightReservation.Enabled = true
+	billing := service.NewBillingCacheService(nil, nil, nil, nil, nil, nil, cfg, nil)
+	t.Cleanup(billing.Stop)
+	key := &service.APIKey{User: &service.User{ID: 1}}
+	_, done, err := reserveInflightBalanceCtx(context.Background(), billing, &countingEstimator{priced: true}, key, nil, service.InflightEstimateRequest{Model: "free"})
+	require.NoError(t, err)
+	done()
+	_, done, err = reserveInflightBalanceCtx(context.Background(), nil, nil, key, nil, service.InflightEstimateRequest{})
+	require.NoError(t, err)
+	done()
+}
+
