+func (g *backgroundTaskGroup) goTask(task func()) {
+	g.mu.Lock()
+	if g.pending == 0 {
+		g.done = make(chan struct{})
+	}
+	g.pending++
+	g.mu.Unlock()
+	go func() {
+		defer func() {
+			g.mu.Lock()
+			g.pending--
+			if g.pending == 0 {
+				close(g.done)
+			}
+			g.mu.Unlock()
+		}()
+		task()
+	}()
+}
+
+// goUsageTask also exposes actual queued/running work to the process drain
+// probe. Idle consumer loops use goTask so they do not keep the probe busy.
+func (g *backgroundTaskGroup) goUsageTask(task func()) {
+	done := drainprobe.BeginUsage()
+	g.goTask(func() {
+		defer done()
+		task()
+	})
+}
+
+func (g *backgroundTaskGroup) wait(ctx context.Context) error {
+	for {
+		g.mu.Lock()
+		if g.pending == 0 {
+			g.mu.Unlock()
+			return nil
+		}
+		done := g.done
+		g.mu.Unlock()
+		select {
+		case <-done:
+		case <-ctx.Done():
+			return ctx.Err()
+		}
+	}
+}
+
+func (g *backgroundTaskGroup) count() int64 {
+	g.mu.Lock()
+	defer g.mu.Unlock()
+	return g.pending
+}
+
+var postUsageBillingTasks backgroundTaskGroup
+
+// WaitPostUsageBillingTasks waits for detached quota/cache/notification work.
+// Call only after HTTP, Live, background producers and the usage pool drained.
+// A deadline reports pending work without canceling it or permitting DB closure.
+func WaitPostUsageBillingTasks(ctx context.Context) error {
+	return postUsageBillingTasks.wait(ctx)
+}
+
+func PendingPostUsageBillingTasks() int64 { return postUsageBillingTasks.count() }
