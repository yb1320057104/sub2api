+func TestHADrainStreamingAndHijackedHandlers(t *testing.T) {
+	for _, hijack := range []bool{false, true} {
+		t.Run(map[bool]string{false: "SSE", true: "WebSocketHijack"}[hijack], func(t *testing.T) {
+			d := newRequestDrain()
+			entered, release := make(chan struct{}), make(chan struct{})
+			server := httptest.NewServer(d.Handler(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+				if hijack {
+					h, ok := w.(http.Hijacker)
+					if !ok {
+						t.Error("hijacker lost")
+						return
+					}
+					conn, buf, err := h.Hijack()
+					if err != nil {
+						t.Error(err)
+						return
+					}
+					defer conn.Close()
+					_, _ = buf.WriteString("HTTP/1.1 101 Switching Protocols\r\nConnection: upgrade\r\nUpgrade: websocket\r\n\r\n")
+					_ = buf.Flush()
+					close(entered)
+					<-release
+					return
+				}
+				w.Header().Set("Content-Type", "text/event-stream")
+				_, _ = io.WriteString(w, "data: first\n\n")
+				w.(http.Flusher).Flush()
+				close(entered)
+				<-release
+				_, _ = io.WriteString(w, "data: last\n\n")
+			})))
+			defer server.Close()
+			conn, err := net.Dial("tcp", strings.TrimPrefix(server.URL, "http://"))
+			require.NoError(t, err)
+			defer conn.Close()
+			_, err = io.WriteString(conn, "GET /v1/responses HTTP/1.1\r\nHost: test\r\n\r\n")
+			require.NoError(t, err)
+			resp, err := http.ReadResponse(bufio.NewReader(conn), nil)
+			require.NoError(t, err)
+			defer resp.Body.Close()
+			<-entered
+			finished := make(chan struct{})
+			go func() { drainHTTP(server.Config, d, 10*time.Millisecond); close(finished) }()
+			select {
+			case <-finished:
+				t.Fatal("drain returned while stream was active")
+			case <-time.After(30 * time.Millisecond):
+			}
+			close(release)
+			if !hijack {
+				body, err := io.ReadAll(resp.Body)
+				require.NoError(t, err)
+				require.Equal(t, "data: first\n\ndata: last\n\n", string(body))
+			}
+			select {
+			case <-finished:
+			case <-time.After(2 * time.Second):
+				t.Fatal("drain failed to finish")
+			}
+		})
+	}
+}
