# Copy into a restricted, ignored local environment file. These are paths and
# image identifiers only; the shared bearer belongs exclusively in TOKEN_FILE.
KILO_RUNTIME_IMAGE=sub2api-kilo-runtime:reviewed-local
KILO_SENTINEL_ASSETS=/build/authorized-sentinel
KILO_TOKEN_FILE=/etc/sub2api-kilo/service.token
# Dedicated decimal GID (1024..2147483647), unused by either image's primary
# accounts or any unrelated image group. The app wrapper registers membership.
KILO_TOKEN_GID=29999
KILO_CONCURRENCY=1
