name: {{ site_id }}-storage
x-common: &common
  network_mode: host
  restart: unless-stopped
  security_opt: ["no-new-privileges:true"]
  logging:
    driver: local
    options: {max-size: 10m, max-file: '3'}
services:
{% if mode == 'ha' %}
  etcd:
    <<: *common
    image: quay.io/coreos/etcd:v3.5.17
    container_name: {{ site_id }}-etcd
    user: '0:0'
    read_only: true
    cap_drop: [ALL]
    mem_limit: 512m
    pids_limit: 128
    command:
      - /usr/local/bin/etcd
      - --name={{ node_role }}
      - --data-dir=/etcd-data
      - --listen-client-urls=http://{{ mesh_ip }}:2379
      - --advertise-client-urls=http://{{ mesh_ip }}:2379
      - --listen-peer-urls=http://{{ mesh_ip }}:2380
      - --initial-advertise-peer-urls=http://{{ mesh_ip }}:2380
      - --initial-cluster={% for host in groups['cluster'] %}{{ hostvars[host].node_role }}=http://{{ hostvars[host].mesh_ip }}:2380{% if not loop.last %},{% endif %}{% endfor %}

      - --initial-cluster-token={{ site_id }}
      - --initial-cluster-state=new
      - --heartbeat-interval=500
      - --election-timeout=5000
      - --auto-compaction-retention=1
      - --quota-backend-bytes=268435456
    volumes:
      - {{ site_dir }}/storage/etcd-data:/etcd-data
  sentinel:
    <<: *common
    image: redis:7.4.2-bookworm
    container_name: {{ site_id }}-sentinel
    user: '999:999'
    read_only: true
    cap_drop: [ALL]
    mem_limit: 128m
    pids_limit: 64
    command: [redis-server, /config/sentinel.conf, --sentinel]
    volumes:
      - {{ site_dir }}/storage/sentinel-config:/config
      - {{ site_dir }}/storage/sentinel-data:/data
{% endif %}
{% if inventory_hostname in groups['data'] %}
  postgres:
    <<: *common
    container_name: {{ site_id }}-postgres
    user: '999:999'
    read_only: true
    cap_drop: [ALL]
    mem_limit: 2g
    cpus: 2
    pids_limit: 256
    shm_size: 256m
    stop_grace_period: 120s
    tmpfs: ['/tmp:rw,nosuid,nodev,size=64m,mode=1777', '/var/run/postgresql:rw,nosuid,nodev,size=8m,mode=0777']
{% if mode == 'ha' %}
    build: ./build
    image: {{ site_id }}-patroni:pg18.1-patroni4.1.5
    environment:
      PATRONI_POSTGRESQL_CONNECT_ADDRESS: {{ mesh_ip }}:5432
    volumes:
      - {{ site_dir }}/storage/patroni:/config:ro
      - {{ site_dir }}/storage/pgdata:/var/lib/postgresql
{% else %}
    image: postgres:18.1-bookworm
    environment:
      PGDATA: /var/lib/postgresql/18/docker
      PGPORT: '6432'
      POSTGRES_USER: postgres
      POSTGRES_DB: postgres
      POSTGRES_PASSWORD_FILE: /run/secrets/pg-superuser-password
      POSTGRES_INITDB_ARGS: --data-checksums --auth-host=scram-sha-256
    command: [postgres, -p, '6432', -c, 'listen_addresses={{ mesh_ip }}', -c, max_connections=100, -c, shared_buffers=512MB]
    volumes:
      - {{ site_dir }}/storage/pgdata:/var/lib/postgresql
      - {{ site_dir }}/storage/patroni/pg-superuser-password:/run/secrets/pg-superuser-password:ro
      - {{ site_dir }}/storage/initdb:/docker-entrypoint-initdb.d:ro
{% endif %}
  redis:
    <<: *common
    image: redis:7.4.2-bookworm
    container_name: {{ site_id }}-redis
    user: '999:999'
    read_only: true
    cap_drop: [ALL]
    mem_limit: 512m
    pids_limit: 128
    command: [redis-server, /config/redis.conf]
    volumes:
      - {{ site_dir }}/storage/redis-config:/config
      - {{ site_dir }}/storage/redis-data:/data
{% if mode == 'ha' %}
  postgres-proxy:
    <<: *common
    image: haproxy:3.0.5-bookworm
    container_name: {{ site_id }}-postgres-proxy
    user: '0:0'
    read_only: true
    cap_drop: [ALL]
    mem_limit: 128m
    pids_limit: 64
    command: [haproxy, -W, -db, -f, /usr/local/etc/haproxy/haproxy.cfg]
    volumes:
      - {{ site_dir }}/storage/proxy/haproxy.cfg:/usr/local/etc/haproxy/haproxy.cfg:ro
{% endif %}
{% endif %}
