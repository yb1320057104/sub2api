# Generated per site. Keep this file private and out of Git.
DATA_DIR=/app/data
SERVER_MODE=release
RUN_MODE=standard
TZ=Asia/Shanghai
SUB2API_DOCKER_SELF_UPDATE=false
PK_AUTH_BROWSER_BOOTSTRAP=true
PK_AUTH_BROWSER_NO_SANDBOX=true
SUB2API_SHARED_STATE_REQUIRED=true
BILLING_INFLIGHT_RESERVATION_ENABLED=true
SUB2API_GRACEFUL_DRAIN=true
SUB2API_DRAIN_SOCKET=/app/data/drain.sock
SUB2API_DRAIN_TIMEOUT_SECONDS=900
DATABASE_HOST={{ mesh_ip }}
DATABASE_PORT=6432
DATABASE_USER=sub2api_app
DATABASE_PASSWORD={{ cluster_secrets.pg_app_password }}
DATABASE_DBNAME=sub2api
DATABASE_SSLMODE=disable
DATABASE_MAX_IDLE_CONNS=6
DATABASE_CONN_MAX_LIFETIME_MINUTES=30
DATABASE_CONN_MAX_IDLE_TIME_MINUTES=5
REDIS_USERNAME=default
REDIS_PASSWORD={{ cluster_secrets.redis_password }}
REDIS_DB=0
REDIS_POOL_SIZE=24
REDIS_MIN_IDLE_CONNS=2
REDIS_ENABLE_TLS=false
{% if mode == 'ha' %}
REDIS_SENTINEL_MASTER_NAME={{ site_id }}
REDIS_SENTINEL_ADDRS={% for host in groups['cluster'] %}{{ hostvars[host].mesh_ip }}:26379{% if not loop.last %},{% endif %}{% endfor %}

REDIS_SENTINEL_USERNAME=default
REDIS_SENTINEL_PASSWORD={{ cluster_secrets.redis_sentinel_password }}
{% else %}
REDIS_HOST={{ mesh_ip }}
REDIS_PORT=6379
{% endif %}
JWT_SECRET={{ cluster_secrets.jwt_secret }}
TOTP_ENCRYPTION_KEY={{ cluster_secrets.totp_key }}
ADMIN_EMAIL={{ admin_email }}
ADMIN_PASSWORD={{ cluster_secrets.admin_password }}
TURNSTILE_REQUIRED=false
TURNSTILE_EXPECTED_HOSTNAMES={% for host in groups['data'] %}{{ hostvars[host].domain }}{% if not loop.last %},{% endif %}{% endfor %}

NO_PROXY=localhost,127.0.0.1,{% for host in groups['cluster'] %}{{ hostvars[host].mesh_ip }}{% if not loop.last %},{% endif %}{% endfor %}

no_proxy=localhost,127.0.0.1,{% for host in groups['cluster'] %}{{ hostvars[host].mesh_ip }}{% if not loop.last %},{% endif %}{% endfor %}
