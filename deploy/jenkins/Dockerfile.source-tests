# syntax=docker/dockerfile:1.7
# Test tooling only. Application source and production configuration are never
# copied into this image; release builds remain in the Jenkins package job.
FROM golang:1.27.3-alpine AS go-tools
ENV GOTOOLCHAIN=local
RUN GOMAXPROCS=8 GOBIN=/out go install golang.org/x/vuln/cmd/govulncheck@v1.8.0

FROM node:24-alpine AS node-tools

FROM docker:29.8.1-dind
LABEL org.opencontainers.image.title="PK isolated source validation tools" \
      org.opencontainers.image.source="https://github.com/yb1320057104/sub2api" \
      pk.purpose="source-validation-tools"

RUN apk add --no-cache \
    bash build-base ca-certificates coreutils curl diffutils findutils \
    git grep gzip linux-headers openssh-client python3 python3-dev py3-pip \
    sed tar tzdata util-linux xz

COPY --from=go-tools /usr/local/go /usr/local/go
COPY --from=go-tools /out/govulncheck /usr/local/bin/govulncheck
COPY --from=node-tools /usr/local/bin/node /usr/local/bin/node
COPY --from=node-tools /usr/local/lib/node_modules /usr/local/lib/node_modules

ENV PATH="/opt/source-tests-venv/bin:/usr/local/go/bin:${PATH}" \
    GOTOOLCHAIN=local \
    PYTHONDONTWRITEBYTECODE=1 \
    DOCKER_HOST=unix:///var/run/docker.sock \
    DOCKER_TLS_CERTDIR=""

RUN ln -s /usr/local/lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm \
    && ln -s /usr/local/lib/node_modules/npm/bin/npx-cli.js /usr/local/bin/npx \
    && npm install --global pnpm@9.15.9 \
    && python3 -m venv /opt/source-tests-venv \
    && pip install --no-cache-dir PyYAML==6.0.3

# SHA256 comes from the official v2.14.0 release checksums, not a mirror.
RUN curl -fsSL --retry 3 \
      https://github.com/golangci/golangci-lint/releases/download/v2.14.0/golangci-lint-2.14.0-linux-amd64.tar.gz \
      -o /tmp/golangci-lint.tar.gz \
    && echo 'ab90aeb7b066f92a33415b638a50fe5344bbb75a0d32ad30cc248d88f81032ab  /tmp/golangci-lint.tar.gz' | sha256sum -c - \
    && tar -xzf /tmp/golangci-lint.tar.gz -C /tmp \
    && mv /tmp/golangci-lint-2.14.0-linux-amd64/golangci-lint /usr/local/bin/golangci-lint \
    && rm -rf /tmp/golangci-lint.tar.gz /tmp/golangci-lint-2.14.0-linux-amd64 \
    && go version && node --version && pnpm --version \
    && python3 -c 'import sys,yaml; assert sys.version_info >= (3,12); assert yaml.__version__ == "6.0.3"' \
    && golangci-lint version && govulncheck -version && docker compose version

WORKDIR /workspace

# Supplying "dockerd" explicitly prevents the official entrypoint from adding
# a TCP listener. Each run needs its own privileged container, 8 CPU / 16 GiB,
# private /var/lib/docker, and only that run's source/output mounts. Never mount
# the host Docker socket, production data, host network or host PID namespace.
CMD ["dockerd", "--host=unix:///var/run/docker.sock"]
