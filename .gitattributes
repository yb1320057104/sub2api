# 确保所有 SQL 迁移文件使用 LF 换行符
backend/migrations/*.sql text eol=lf

# Go 源代码文件
*.go text eol=lf

# 前端 源代码文件
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.vue text eol=lf

# Shell 脚本
*.sh text eol=lf

# YAML/YML 配置文件
*.yaml text eol=lf
*.yml text eol=lf

# Dockerfile
Dockerfile text eol=lf

# HA adaptation patches are byte-pinned by their manifests, including line endings.
deploy/cluster-updater/overlays/pk62-r2/adaptation.patch -text
deploy/cluster-updater/overlays/pk62-r3/adaptation.patch -text
