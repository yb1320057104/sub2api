# =============================================================================
# Sub2API Dockerfile for GoReleaser
# =============================================================================
# This Dockerfile is used by GoReleaser to build Docker images.
# It only packages the pre-built binary, no compilation needed.
# =============================================================================

ARG ALPINE_IMAGE=alpine:3.21
ARG POSTGRES_IMAGE=postgres:18-alpine

FROM ${POSTGRES_IMAGE} AS pg-client

FROM ${ALPINE_IMAGE} AS runtime-base

LABEL maintainer="Wei-Shaw <github.com/Wei-Shaw>"
LABEL description="Sub2API - AI API Gateway Platform"
LABEL org.opencontainers.image.source="https://github.com/pengkang0322/sub2api"

# PK releases use the existing application data volume for web-based updates.
ENV SUB2API_DOCKER_SELF_UPDATE=true
# Browser runs as the unprivileged application user inside this container.
ENV PK_AUTH_BROWSER_PATH=/usr/bin/chromium PK_AUTH_BROWSER_NO_SANDBOX=true

# Install runtime dependencies
RUN apk add --no-cache \
    ca-certificates \
    chromium \
    tzdata \
    curl \
    su-exec \
    libpq \
    zstd-libs \
    lz4-libs \
    krb5-libs \
    libldap \
    libedit \
    && rm -rf /var/cache/apk/*

# Copy pg_dump and psql from a version-matched PostgreSQL image so backup and
# restore work in the runtime container without requiring Docker socket access.
COPY --from=pg-client /usr/local/bin/pg_dump /usr/local/bin/pg_dump
COPY --from=pg-client /usr/local/bin/psql /usr/local/bin/psql
COPY --from=pg-client /usr/local/lib/libpq.so.5* /usr/local/lib/

# Create non-root user
RUN addgroup -g 1000 sub2api && \
    adduser -u 1000 -G sub2api -s /bin/sh -D sub2api

WORKDIR /app

# This export-only stage reserves an interpreter slot for unprivileged runtime
# relocation. The final application image keeps its ordinary native binaries.
FROM runtime-base AS browser-export
RUN set -eu; apk add --no-cache patchelf && \
    loader=/__PK_BROWSER_LOADER__/ && \
    for index in $(seq 1 64); do loader="$loader"reserved/; done && \
    for binary in /usr/lib/chromium/*; do \
        if [ -f "$binary" ] && patchelf --print-interpreter "$binary" >/dev/null 2>&1; then \
            patchelf --set-interpreter "$loader" "$binary"; \
        fi; \
    done && \
    test "$(patchelf --print-interpreter /usr/lib/chromium/chrome)" = "$loader"

FROM runtime-base AS runtime

# Copy the pre-built binary and runtime fallback resources from GoReleaser
COPY --chown=root:root --chmod=0555 sub2api /app/sub2api
COPY --chown=sub2api:sub2api backend/resources /app/resources

# Create data directory
RUN mkdir -p /app/data && chown sub2api:sub2api /app/data

# Copy entrypoint script (fixes volume permissions then drops to sub2api)
COPY deploy/docker-entrypoint.sh /app/docker-entrypoint.sh
RUN chmod +x /app/docker-entrypoint.sh

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=10s --start-period=10s --retries=3 \
    CMD curl -f http://localhost:${SERVER_PORT:-8080}/health || exit 1

# Run the application (entrypoint fixes /app/data ownership then execs as sub2api)
ENTRYPOINT ["/app/docker-entrypoint.sh"]
CMD ["/app/sub2api"]
